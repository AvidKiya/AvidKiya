# Site URL used for payment callbacks
NEXT_PUBLIC_SITE_URL=https://your-domain.com
SITE_URL=https://your-domain.com

# JWT/auth
JWT_SECRET=change-me

# Payment gateway option 1: Zarinpal
# Prices in the shop are Toman; checkout converts to Rial for Zarinpal automatically.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Payment gateway option 2: any external payment/payment-link provider
# If set, checkout redirects here with ?orderId=...&amount=...
PAYMENT_EXTERNAL_URL=

# Cloudflare KV REST storage (server-side only)
# Used for CMS, messages and shop orders. If omitted, the app falls back to in-memory storage for local development.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=

# Resend email delivery for invoices/download links
RESEND_API_KEY=
EMAIL_FROM="AvidKiya <no-reply@your-domain.com>"

# AI provider (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Cloudflare Workers AI instead of OpenAI-compatible provider
WORKERS_AI_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OAuth social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Monitoring webhook (optional Slack/Discord/custom endpoint)
MONITORING_WEBHOOK_URL=

# GitHub deployer API
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main
GITHUB_DISPATCH_EVENT=deploy

# Optional push gateway for real encrypted Web Push delivery
PUSH_GATEWAY_URL=
