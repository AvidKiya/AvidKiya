# Site
NEXT_PUBLIC_SITE_URL=https://avidkiya.com
NEXT_PUBLIC_GITHUB_USERNAME=avidkiya

# CMS / Admin
# حتماً در Cloudflare مقدار قوی بگذارید؛ رمز پیش‌فرض داخل کد وجود ندارد.
ADMIN_PASSWORD=change-this-to-a-long-private-password
ADMIN_SECRET=change-this-to-a-64-char-random-secret
# یا به‌جای ADMIN_PASSWORD از هش SHA-256 رمز استفاده کنید:
# ADMIN_PASSWORD_SHA256=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Database (Cloudflare D1)
# npx wrangler d1 create kiya-planner

# KV
# npx wrangler kv:namespace create CMS_KV

# AI
OPENAI_API_KEY=
CLOUDFLARE_AI_ACCOUNT_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Avid Kiya <hello@avidkiya.com>"

# Telegram Bot (منشی)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET=

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=avidkiya.com

# Payments
# (Zarinpal / Stripe keys in Phase 4)
CAFE_CARD_NUMBER=6037997000000000
CAFE_CARD_HOLDER=Avid Kiya
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
